local function setSlider(v)
	v = math.clamp(v, SL_MIN, SL_MAX)
	v = math.floor(v * 10 + 0.5) / 10
	dropDelay = v

	local tw = sliderTrack.AbsoluteSize.X
	if tw <= 0 then tw = TRACK_W end

	local frac = (v - SL_MIN) / (SL_MAX - SL_MIN)
	local fp = frac * tw

	sliderFill.Size = UDim2.new(0, fp, 1, 0)
	sliderKnob.Position = UDim2.new(0, fp, 0.5, 0)
	sliderValue.Text = string.format("%.1fs", v)
end

local function setSliderFromX(px)
	local ap = sliderTrack.AbsolutePosition
	local tw = sliderTrack.AbsoluteSize.X
	if tw <= 0 then return end

	local frac = (px - ap.X) / tw
	setSlider(SL_MIN + frac * (SL_MAX - SL_MIN))
end

local function pointInSlider(px, py)
	local ap, asz = sliderTrack.AbsolutePosition, sliderTrack.AbsoluteSize
	return px >= ap.X - 10 and px <= ap.X + asz.X + 10
		and py >= ap.Y - 12 and py <= ap.Y + asz.Y + 12
end

