local function mk(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end

local function tween(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local function playSound(id)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = SOUND_VOLUME
	s.Parent = player:WaitForChild("PlayerGui")
	s:Play()
	Debris:AddItem(s, 3)
end

------------------------------------------------------------
-- CANDY FOLDERS
------------------------------------------------------------
local function getFolders()
	local list, seen = {}, {}
	local function add(f)
		if f and not seen[f] then
			seen[f] = true
			table.insert(list, f)
		end
	end
	local ha = workspace:FindFirstChild("HalloweenArea")
	add(ha and ha:FindFirstChild("CandySpawns"))
	add(workspace:FindFirstChild("HalloweenCandy"))
	add(workspace:FindFirstChild("Halloween Candy"))
	add(workspace:FindFirstChild("CandySpawns"))
	return list
end

local function getPad()
	local f = workspace:FindFirstChild("CandyDropOff")
	if f and f:FindFirstChild("Pad") then
		return f.Pad
	end

	local ok, pad = pcall(function()
		return workspace:WaitForChild("CandyDropOff", 5):WaitForChild("Pad", 5)
	end)

	if ok and pad then
		return pad
	end

	return nil
end

------------------------------------------------------------
-- FUNCTIONS
------------------------------------------------------------
local function getChar()
	return player.Character or player.CharacterAdded:Wait()
end

local function teleportTo(pos)
	local hrp = getChar():WaitForChild("HumanoidRootPart")
	hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
end

local function isPicked(m)
	local t = pickedAt[m]
	if not t then return false end
	if os.clock() - t > 25 then
		pickedAt[m] = nil
		return false
	end
	return true
end

local function isAvailable(m)
	if not m or not m.Parent then return false end
	if isPicked(m) then return false end
	if m:IsA("BasePart") and m.Transparency < 0.95 then return true end
	for _, d in pairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 0.95 then return true end
	end
	return false
end

local function hasPrompt(m)
	if m:IsA("ProximityPrompt") then return true end
	for _, d in pairs(m:GetDescendants()) do
		if d:IsA("ProximityPrompt") then return true end
	end
	return false
end

local function pickCandy()
	local avail, withP = {}, {}
	for _, f in pairs(getFolders()) do
		for _, c in pairs(f:GetChildren()) do
			if (c:IsA("Model") or c:IsA("BasePart")) and isAvailable(c) then
				table.insert(avail, c)
				if hasPrompt(c) then table.insert(withP, c) end
			end
		end
	end
	local pool = (#withP > 0) and withP or avail
	if #pool == 0 then return nil end
	return pool[math.random(1, #pool)]
end

local function candyPos(m)
	if m:IsA("Model") then return m:GetPivot().Position end
	if m:IsA("BasePart") then return m.Position end
	return nil
end

local function promptPos(p)
	local par = p.Parent
	for i = 1, 2 do
		if not par then break end
		if par:IsA("BasePart") then return par.Position end
		if par:IsA("Model") then return par:GetPivot().Position end
		par = par.Parent
	end
	return nil
end

local function findPrompt(obj, hrp)
	if obj:IsA("ProximityPrompt") then return obj end
	for _, d in pairs(obj:GetDescendants()) do
		if d:IsA("ProximityPrompt") then return d end
	end
	if not hrp then return nil end
	local best, bd = nil, 30
	for _, d in pairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local pos = promptPos(d)
			if pos then
				local dist = (pos - hrp.Position).Magnitude
				if dist < bd then best, bd = d, dist end
			end
		end
	end
	return best
end

local function holdE(prompt)
	pcall(function()
		prompt.Enabled = true
		prompt.KeyCode = Enum.KeyCode.E
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 20)
	end)
	pcall(function() prompt:InputHoldBegin() end)
	task.wait(math.max(prompt.HoldDuration, 0.3) + 0.2)
	pcall(function() prompt:InputHoldEnd() end)
end

