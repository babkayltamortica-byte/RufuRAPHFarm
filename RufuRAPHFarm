------------------------------------------------------------
-- SLIDER DRAG
------------------------------------------------------------
local function tryBeginSlider(inp)
	if loading or draggingSlider or not mainFrame.Visible then return end

	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		if not pointInSlider(inp.Position.X, inp.Position.Y) then return end

		draggingSlider = true
		playSound(SOUND_CLICK)
		setSliderFromX(inp.Position.X)
	end
end

sliderTrack.InputBegan:Connect(tryBeginSlider)
sliderKnob.InputBegan:Connect(tryBeginSlider)

------------------------------------------------------------
-- INPUT HANDLER
------------------------------------------------------------
UIS.InputBegan:Connect(function(inp, processed)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		tryBeginSlider(inp)
	end

	if processed then return end

	if inp.KeyCode == Enum.KeyCode.E then
		eHolding = true
		if isActive and canCollect and not hasCandy then
			task.spawn(function()
				task.wait(0.3)
				if eHolding and isActive and canCollect and not hasCandy then
					collectCandy()
				end
			end)
		end
	end
end)

UIS.InputChanged:Connect(function(inp)
	if dragging and inp == dragInput then
		local d = inp.Position - dragStart
		mainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + d.X,
			startPos.Y.Scale,
			startPos.Y.Offset + d.Y
		)
	end

	if draggingSlider and not loading and mainFrame.Visible then
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
			setSliderFromX(inp.Position.X)
		end
	end
end)

UIS.InputEnded:Connect(function(inp)
	if inp.KeyCode == Enum.KeyCode.E then
		eHolding = false
	end

	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		draggingSlider = false
	end
end)

