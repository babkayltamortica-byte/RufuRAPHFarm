------------------------------------------------------------
-- CORE LOGIC
------------------------------------------------------------
local teleportToNextCandy
local collectCandy

collectCandy = function()
	if not canCollect or hasCandy or not currentCandy then return end
	canCollect, hasCandy = false, true

	local char = getChar()
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		hasCandy = false
		return
	end

	local collected = false

	for attempt = 1, MAX_PICK_ATTEMPTS do
		if attempt == 1 then
			statusLabel.Text = "🍬 Holding E to take candy..."
		else
			statusLabel.Text = "🔁 Candy is still there — trying again..."
		end

		local prompt = findPrompt(currentCandy, hrp)
		if prompt then
			holdE(prompt)
			task.wait(0.25)

			if not isAvailable(currentCandy) then
				collected = true
				break
			end
		else
			break
		end
	end

	if currentCandy then
		pickedAt[currentCandy] = os.clock()
	end

	if not collected then
		statusLabel.Text = "⚠️ Could not take this candy, searching another..."
		hintLabel.Text = ""
		hasCandy = false
		task.wait(0.35)

		if isActive then
			teleportToNextCandy()
		end
		return
	end

	statusLabel.Text = string.format("🍬 Collected! Teleporting to Pad in %.1fs...", dropDelay)
	hintLabel.Text = ""

	task.wait(dropDelay)
	if not isActive then return end

	local pad = getPad()
	if not pad then
		statusLabel.Text = "❌ CandyDropOff Pad not found!"
		hintLabel.Text = "Check workspace > CandyDropOff > Pad"
		hasCandy = false
		task.wait(0.6)

		if isActive then
			teleportToNextCandy()
		end
		return
	end

	teleportTo(pad.Position)
	task.wait(0.4)

	hrp = getChar():FindFirstChild("HumanoidRootPart")
	local padPrompt = findPrompt(pad, hrp)
	if padPrompt then
		statusLabel.Text = "📦 Holding E on Pad — delivering candy..."
		holdE(padPrompt)
	end

	task.wait(0.4)
	if not isActive then return end

	statusLabel.Text = "🎉 Cycle complete! Scanning for more candy..."
	hasCandy = false
	task.wait(0.6)
	teleportToNextCandy()
end

teleportToNextCandy = function()
	if not isActive then return end

	currentCandy = nil

	for attempt = 1, 10 do
		local cand = pickCandy()
		if not cand then break end

		local pos = candyPos(cand)
		if pos and isAvailable(cand) then
			currentCandy = cand
			teleportTo(pos)

			if isAvailable(currentCandy) then
				break
			end

			currentCandy = nil
		end
	end

	if not currentCandy then
		statusLabel.Text = "😢 No visible candy found!"
		hintLabel.Text = "Will re-check after next activation."
		canCollect = false
		return
	end

	canCollect = true
	statusLabel.Text = "🎃 Candy located! Holding E to grab..."
	hintLabel.Text = "Sit back — everything is automatic."

	task.spawn(function()
		task.wait(0.4)
		if isActive and canCollect and not hasCandy then
			collectCandy()
		end
	end)
end

toggleBtn.MouseButton1Click:Connect(function()
	if loading then return end

	isActive = not isActive

	if isActive then
		toggleBtn.Text = "⏹  STOP"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 30)
		toggleStroke.Color = Color3.fromRGB(255, 80, 50)
		pickedAt = {}
		statusLabel.Text = "🚀 Hunt started! Scanning for candy..."
		task.wait(0.2)
		teleportToNextCandy()
	else
		toggleBtn.Text = "▶  START"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 120, 10)
		toggleStroke.Color = Color3.fromRGB(255, 180, 50)
		canCollect, hasCandy, currentCandy = false, false, nil
		statusLabel.Text = "Press START to begin the candy hunt!"
		hintLabel.Text = ""
	end
end)

